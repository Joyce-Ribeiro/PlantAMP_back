# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
# Não existe usuário/senha de admin aqui: admins vivem no banco
# e o primeiro é criado pelo terminal (python -m app.cli create-admin).

# ---------- Banco ----------
MOTHERDUCK_TOKEN=
DATABASE_FILE=md:plantamp_db
# Local: DATABASE_FILE=data/plantamp.duckdb

# ---------- Tokens de login ----------
# Chave que ASSINA os tokens (não é senha de ninguém). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Proteção contra força bruta ----------
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---------- Recuperação de senha ----------
# Endereço público da API (o link do e-mail aponta para ADMIN_BASE_URL/admin/reset-password)
ADMIN_BASE_URL=http://localhost:8000
RESET_TOKEN_EXPIRE_MINUTES=30
MAX_RESET_REQUESTS_PER_HOUR=3

# SMTP (opcional). Sem SMTP_HOST o link aparece só no log do servidor.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=conta@gmail.com,
#        SMTP_PASSWORD=<senha de app de 16 letras>, SMTP_FROM=conta@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---------- CORS ----------
# Domínio(s) do front-end público, em JSON:
CORS_ORIGINS=["http://localhost:5173"]

# ---------- Importação ----------
MAX_CSV_MB=20

# ---------- Coletas de dados (GitHub Actions) ----------
# Opcional. Sem GITHUB_TOKEN e GITHUB_REPO, a seção "Coletas de dados" do
# painel fica desativada (as coletas ainda podem ser rodadas pela aba Actions).
#
# GITHUB_TOKEN: token "fine-grained" do GitHub. Crie em
#   foto do perfil → Settings → Developer settings → Personal access tokens
#   → Fine-grained tokens → Generate new token, com:
#     Repository access: Only select repositories → só este repositório
#     Permissions → Repository permissions → Actions: Read and write
#   Começa com github_pat_ e só aparece uma vez. Anote a data de expiração.
GITHUB_TOKEN=
# Repositório dos workflows, no formato usuario/repositorio
# (o que vem depois de github.com/ na URL). Ex.: joyceribeiro/PlantAMP_back
GITHUB_REPO=
# Branch onde estão os arquivos .github/workflows/coleta-*.yml
GITHUB_REF=main
#
# O MOTHERDUCK_TOKEN do GitHub Actions NÃO vem deste arquivo: cadastre-o em
#   repositório → Settings → Secrets and variables → Actions → New repository secret
